---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import ProductLoop from "../components/ProductLoop.astro";
import VisualProducts from "../components/VisualProducts.astro";
import Process from "../components/Process.astro";
import Prototypes from "../components/Prototypes.astro";
import Differentiators from "../components/Differentiators.astro";
import BrandStatement from "../components/BrandStatement.astro";
import Customization from "../components/Customization.astro";
import Pricing from "../components/Pricing.astro";
---

<Layout>
  <Header />
  <div class="hero-main">
    <Hero />
    <ProductLoop />
    <VisualProducts />
    <Process />
    <div class="prototypes-criteria-canvas">
      <Prototypes />
      <Differentiators />
    </div>
    <BrandStatement />
    <Customization />
    <Pricing />
  </div>
</Layout>

<style>
  .prototypes-criteria-canvas {
    width: 100%;
    max-width: var(--container-hero);
    margin-inline: auto;
    background: var(--bg-canvas-light);
    border: 1px solid var(--border-light-subtle);
    border-radius: var(--canvas-radius);
  }
</style>
