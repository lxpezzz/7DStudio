---
import { Image } from "astro:assets";
import realDigital from "../assets/images/brand/real-digital.webp";
---

<section class="statement-section" id="statement" data-header-theme="dark">
  <div class="section-container">
    <div class="statement-wrap" id="statementScene">
      <!-- Big Hero Brand Image -->
      <div class="statement-image-frame" id="statementImageFrame">
        <Image
          src={realDigital}
          alt="Conexión entre el mundo físico y digital - 7DStudio"
          class="statement-hero-img"
          width={1220}
          height={680}
          loading="lazy"
        />
      </div>

      <!-- Narrative & Action -->
      <div class="statement-narrative" id="statementNarrative">
        <h2 class="statement-title" id="statementTitle">
          De lo real a lo virtual.
        </h2>
        <p class="statement-desc" id="statementDesc">
          Conectamos tu negocio con tus clientes, en cada punto de contacto.
        </p>
        <div class="statement-actions" id="statementActions">
          <a
            href="/#contacto"
            class="statement-cta-btn"
            aria-label="Contactar con 7DStudio"
          >
            <span>Contactar</span>
            <svg
              class="cta-arrow"
              width="16"
              height="16"
              viewBox="0 0 16 16"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M3.333 8h9.334M8.667 4l4 4-4 4"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Section Layout */
  .statement-section {
    width: 100%;
    position: relative;
    padding-bottom: var(--section-space-sm);
    background-color: var(--bg-page);
    overflow: hidden;
  }

  .statement-section :global(.section-container) {
    max-width: var(--container-hero);
  }

  .statement-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 100%;
    gap: clamp(2.5rem, 5vw, 4rem);
  }

  /* Big Hero Image Frame */
  .statement-image-frame {
    width: 100%;
    border-radius: var(--canvas-radius);
    overflow: hidden;
    background-color: var(--bg-canvas-light);
    border: 1px solid var(--border-light-subtle);
    box-shadow: 0 24px 48px -16px rgba(0, 0, 0, 0.08);
    transform-origin: center top;
    will-change: transform, opacity;
  }

  .statement-hero-img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
    user-select: none;
  }

  @media (max-width: 768px) {
    .statement-hero-img {
      aspect-ratio: 4 / 3;
    }
  }

  /* Narrative & CTA */
  .statement-narrative {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 680px;
    margin-inline: auto;
  }

  .statement-title {
    font-size: clamp(2.2rem, 4.5vw, 3.85rem);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: var(--tracking-tightest);
    color: var(--text-light-primary);
    margin-bottom: 1.15rem;
    text-wrap: balance;
    will-change: transform, opacity;
  }

  .statement-desc {
    font-size: var(--text-body-lg);
    line-height: var(--leading-relaxed);
    color: var(--text-light-secondary);
    max-width: 48ch;
    text-wrap: pretty;
    margin-bottom: clamp(1.75rem, 3.2vw, 2.5rem);
    will-change: transform, opacity;
  }

  .statement-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    will-change: transform, opacity;
  }

  /* CTA Button */
  .statement-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    height: 50px;
    padding-inline: 1.85rem;
    border-radius: var(--pill-radius);
    background-color: var(--text-light-primary);
    color: #ffffff;
    font-size: var(--text-body-sm);
    font-weight: 600;
    letter-spacing: -0.01em;
    box-shadow: 0 8px 24px -6px rgba(10, 10, 10, 0.2);
    transition:
      transform var(--duration-smooth) var(--ease-default),
      background-color var(--duration-smooth) var(--ease-default),
      box-shadow var(--duration-smooth) var(--ease-default);
  }

  .statement-cta-btn:hover {
    background-color: #232730;
    transform: translateY(-2px);
    box-shadow: 0 12px 32px -8px rgba(10, 10, 10, 0.3);
  }

  .statement-cta-btn:active {
    transform: scale(0.98);
  }

  .cta-arrow {
    transition: transform var(--duration-quick) var(--ease-default);
  }

  .statement-cta-btn:hover .cta-arrow {
    transform: translateX(3px);
  }
</style>
