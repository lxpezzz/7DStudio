---
import { ArrowRight } from "lucide";
import LucideIcon from "./LucideIcon.astro";

interface Props {
  title: string;
  description: string;
  buttonLabel: string;
  buttonHref: string;
}

const { title, description, buttonLabel, buttonHref } = Astro.props;
---

<footer class="pricing-cta-footer" data-cta data-reveal>
  <div class="cta-narrative">
    <h3 class="cta-heading">{title}</h3>
    <p class="cta-text">{description}</p>
  </div>

  <div class="cta-action">
    <a href={buttonHref} class="cta-button" aria-label={`${buttonLabel} con 7DStudio`}>
      <span>{buttonLabel}</span>
      <span class="cta-arrow-wrap" aria-hidden="true">
        <LucideIcon icon={ArrowRight} size={16} strokeWidth={1.5} class="cta-arrow" />
      </span>
    </a>
  </div>
</footer>

<style>
  .pricing-cta-footer {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: clamp(2rem, 4vw, 4rem);
    flex-wrap: wrap;
    padding-top: clamp(2.5rem, 4.5vw, 4.5rem);
    border-top: 1px solid var(--border-light-subtle);
  }

  .cta-narrative {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-width: 48ch;
  }

  .cta-heading {
    font-size: clamp(1.5rem, 2.4vw, 2.25rem);
    font-weight: 600;
    letter-spacing: var(--tracking-tightest);
    color: var(--text-light-primary);
    line-height: 1.15;
  }

  .cta-text {
    font-size: var(--text-body);
    line-height: var(--leading-relaxed);
    color: var(--text-light-secondary);
    text-wrap: pretty;
  }

  .cta-action {
    display: flex;
    align-items: center;
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    height: 52px;
    padding-inline: 2rem;
    border-radius: var(--pill-radius);
    background-color: var(--text-light-primary);
    color: #ffffff;
    font-size: var(--text-body-sm);
    font-weight: 600;
    letter-spacing: -0.01em;
    box-shadow: 0 8px 24px -6px rgba(10, 10, 10, 0.18);
    transition:
      transform var(--duration-smooth) var(--ease-default),
      background-color var(--duration-smooth) var(--ease-default),
      box-shadow var(--duration-smooth) var(--ease-default);
    white-space: nowrap;
    text-decoration: none;
  }

  .cta-button:hover {
    background-color: #232730;
    transform: translateY(-2px);
    box-shadow: 0 12px 32px -8px rgba(10, 10, 10, 0.28);
  }

  .cta-button:active {
    transform: scale(0.98);
  }

  .cta-arrow-wrap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .cta-arrow {
    transition: transform var(--duration-quick) var(--ease-default);
  }

  .cta-button:hover .cta-arrow {
    transform: translateX(3px);
  }

  @media (max-width: 640px) {
    .cta-button {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-button,
    .cta-arrow {
      transition: none !important;
    }
  }
</style>
