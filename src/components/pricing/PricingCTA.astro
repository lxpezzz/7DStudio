---
interface Props {
  title?: string;
  description?: string;
  buttonLabel?: string;
  buttonHref?: string;
}

const {
  title = "¿Tienes un producto en mente?",
  description = "Cuéntanos qué necesitas y creamos una solución personalizada para tu negocio.",
  buttonLabel = "Cuéntanos tu idea",
  buttonHref = "/#contacto",
} = Astro.props;
---

<div class="physical-cta-banner">
  <div class="cta-text-group">
    <h3 class="cta-title">{title}</h3>
    <p class="cta-text">{description}</p>
  </div>

  <a
    href={buttonHref}
    class="cta-button"
    aria-label={`${buttonLabel} — Contactar con 7DStudio`}
  >
    <span>{buttonLabel}</span>
    <span class="cta-arrow" aria-hidden="true">
      <svg width="15" height="15" viewBox="0 0 16 16" fill="none">
        <path
          d="M3.333 8h9.334M8.667 4l4 4-4 4"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </span>
  </a>
</div>

<style>
  .physical-cta-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(1.25rem, 2.5vw, 2.5rem);
    width: 100%;
    margin-top: clamp(1rem, 1.8vw, 1.5rem);
    padding: clamp(1.25rem, 2vw, 1.75rem) clamp(1.5rem, 2.8vw, 2.25rem);
    background-color: var(--bg-canvas-light);
    border: 1px solid var(--border-light-subtle);
    border-radius: var(--canvas-radius);
  }

  .cta-text-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    max-width: 54ch;
  }

  .cta-title {
    font-size: clamp(1.15rem, 1.5vw, 1.35rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: var(--tracking-tightest);
    color: var(--text-light-primary);
  }

  .cta-text {
    font-size: var(--text-body-sm);
    line-height: var(--leading-relaxed);
    color: var(--text-light-secondary);
    text-wrap: pretty;
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    height: 48px;
    padding-inline: 1.65rem;
    border-radius: var(--pill-radius);
    background-color: var(--text-light-primary);
    color: #ffffff;
    font-size: var(--text-body-sm);
    font-weight: 600;
    letter-spacing: -0.01em;
    box-shadow: 0 4px 14px -3px rgba(10, 10, 10, 0.16);
    transition:
      transform var(--duration-smooth) var(--ease-default),
      background-color var(--duration-smooth) var(--ease-default),
      box-shadow var(--duration-smooth) var(--ease-default);
    white-space: nowrap;
    text-decoration: none;
    flex-shrink: 0;
  }

  @media (hover: hover) and (pointer: fine) {
    .cta-button:hover {
      background-color: #232730;
      transform: translateY(-1px);
      box-shadow: 0 8px 20px -4px rgba(10, 10, 10, 0.24);
    }

    .cta-button:hover .cta-arrow {
      transform: translateX(3px);
    }
  }

  .cta-button:active {
    transform: scale(0.98);
  }

  .cta-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: transform var(--duration-quick) var(--ease-default);
  }

  @media (max-width: 768px) {
    .physical-cta-banner {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.25rem;
      padding: 1.35rem 1.25rem;
    }

    .cta-text-group {
      max-width: 100%;
      gap: 0.35rem;
    }

    .cta-button {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-button,
    .cta-arrow {
      transition: none !important;
      transform: none !important;
    }
  }
</style>
