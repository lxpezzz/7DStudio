---
import { Image } from "astro:assets";
import { Contact, QrCode, Share2, type IconNode } from "lucide";
import LucideIcon from "./LucideIcon.astro";

import expositorImg from "../../assets/products/expositor.webp";
import tarjetasNfcImg from "../../assets/products/tarjetas.webp";
import tarjetasQrImg from "../../assets/solutions/cards.webp";

export interface Product {
  num: string;
  name: string;
  icon?: string;
  tagline: string;
  pricePrefix?: string;
  price: string;
  tax: string;
  customization: string[];
  imageKey: string;
}

interface Props {
  product: Product;
}

const { product } = Astro.props;

const productImages: Record<string, ImageMetadata> = {
  expositor: expositorImg,
  tarjetas: tarjetasNfcImg,
  cards: tarjetasQrImg,
};

const productImage = productImages[product.imageKey];

const productIcons: Record<string, IconNode> = {
  "qr-code": QrCode,
  contact: Contact,
  share: Share2,
};

const productIcon = product.icon ? productIcons[product.icon] : undefined;
---

<article class="physical-card" id={`producto-${product.num}`} data-card data-product={product.num}>
  <!-- Product Preview Visual Stage -->
  <div class="physical-visual-wrap">
    {
      productImage && (
        <Image
          src={productImage}
          alt={product.name}
          class="physical-product-img"
          width={520}
          height={360}
          loading="lazy"
        />
      )
    }
    <span class="physical-card-num">{product.num}</span>
  </div>

  <!-- Product Body -->
  <div class="physical-card-body">
    <div class="physical-card-headline">
      <div class="title-with-icon">
        <h3 class="physical-card-title">{product.name}</h3>

        {
          productIcon && (
            <span class="product-subtle-icon" aria-hidden="true">
              <LucideIcon icon={productIcon} size={15} strokeWidth={1.6} />
            </span>
          )
        }
      </div>

      <div class="physical-card-price">
        {product.pricePrefix && <span class="price-prefix">{product.pricePrefix}</span>}
        <span class="price-val">{product.price}</span>
        <span class="price-tax">{product.tax}</span>
      </div>
    </div>

    <p class="physical-card-tagline">“{product.tagline}”</p>

    <div class="physical-customization">
      <span class="customization-heading">Personalización:</span>
      <ul class="customization-list">
        {
          product.customization.map((item) => (
            <li class="customization-item">
              <span class="customization-dot" aria-hidden="true" />
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</article>

<style>
  .physical-card {
    display: flex;
    flex-direction: column;
    background-color: var(--bg-canvas-light);
    border: 1px solid var(--border-light-subtle);
    border-radius: var(--canvas-radius);
    overflow: hidden;
    transition: border-color var(--duration-smooth) var(--ease-default);
  }

  .physical-card:hover {
    border-color: rgba(10, 10, 10, 0.18);
  }

  .physical-visual-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    background-color: #f4f4f1;
    overflow: hidden;
  }

  .physical-product-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    user-select: none;
    transition: transform var(--duration-smooth) var(--ease-default);
  }

  .physical-card:hover .physical-product-img {
    transform: scale(1.025);
  }

  .physical-card-num {
    position: absolute;
    top: 1rem;
    left: 1rem;
    font-family: monospace;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-light-primary);
    background-color: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    border: 1px solid rgba(0, 0, 0, 0.08);
  }

  .physical-card-body {
    display: flex;
    flex-direction: column;
    padding: clamp(1.25rem, 2vw, 1.75rem);
    gap: 0.65rem;
    flex: 1 1 auto;
  }

  .physical-card-headline {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .title-with-icon {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .physical-card-title {
    font-size: clamp(1.2rem, 1.5vw, 1.35rem);
    font-weight: 600;
    color: var(--text-light-primary);
    letter-spacing: var(--tracking-tightest);
    line-height: 1.2;
  }

  .product-subtle-icon {
    display: inline-flex;
    align-items: center;
    color: var(--text-light-secondary);
    opacity: 0.65;
    flex-shrink: 0;
  }

  .physical-card-price {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
  }

  .price-prefix {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--text-light-secondary);
  }

  .price-val {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--text-light-primary);
    letter-spacing: -0.02em;
  }

  .price-tax {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-light-secondary);
  }

  .physical-card-tagline {
    font-size: var(--text-body-sm);
    color: var(--text-light-secondary);
    line-height: 1.45;
    font-style: italic;
    margin-top: 0.15rem;
  }

  .physical-customization {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    margin-top: 0.65rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--border-light-subtle);
  }

  .customization-heading {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-light-secondary);
  }

  .customization-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.65rem;
    list-style: none;
  }

  .customization-item {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.75rem;
    color: var(--text-light-primary);
    font-weight: 500;
  }

  .customization-dot {
    width: 3.5px;
    height: 3.5px;
    border-radius: 50%;
    background-color: var(--text-light-secondary);
    opacity: 0.6;
    flex-shrink: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .physical-card,
    .physical-product-img {
      transition: none !important;
    }
  }
</style>
