---
const steps = [
  {
    num: "01",
    title: "Hablamos",
    description:
      "Entendemos tu negocio, qué necesitas y el objetivo concreto que buscas conseguir con la web o producto.",
  },
  {
    num: "02",
    title: "Diseñamos",
    description:
      "Definimos la estructura, dirección visual y contenido antes de construir la versión final.",
  },
  {
    num: "03",
    title: "Lanzamos",
    description:
      "Construimos, optimizamos rendimiento y responsive, y dejamos todo listo para empezar a funcionar.",
  },
];
---

<section class="process-section" id="proceso">
  <div class="section-container">
    <!-- Header -->
    <div class="process-header">
      <div class="process-eyebrow">Cómo trabajamos</div>
      <h2 class="process-h2">De la idea a una web lista para trabajar.</h2>
    </div>

    <!-- Process steps -->
    <div class="process-cards-grid">
      {
        steps.map((step) => (
          <article class="process-card">
            <span class="card-num">{Number(step.num)}</span>
            <div class="card-body">
              <h3 class="card-title">{step.title}</h3>
              <p class="card-desc">{step.description}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Section Layout */
  .process-section {
    width: 100%;
    position: relative;
  }

  /* Header */
  .process-header {
    display: flex;
    flex-direction: column;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .process-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: var(--text-caption);
    font-weight: 600;
    color: var(--text-light-secondary);
    letter-spacing: -0.01em;
    margin-bottom: 1rem;
  }

  .process-eyebrow::before {
    content: "";
    width: 5.5px;
    height: 5.5px;
    border-radius: 50%;
    background-color: var(--text-light-primary);
    flex-shrink: 0;
  }

  .process-h2 {
    font-size: clamp(1.85rem, 3.2vw, 2.75rem);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: var(--tracking-tightest);
    color: var(--text-light-primary);
    max-width: 22ch;
    text-wrap: balance;
  }

  /* Process steps */
  .process-cards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    width: 100%;
  }

  @media (min-width: 768px) {
    .process-cards-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: clamp(1.25rem, 2vw, 2rem);
      align-items: stretch;
    }
  }

  /* Process Card */
  .process-card {
    background-color: #ffffff;
    border: 1px solid rgba(10, 10, 10, 0.14);
    border-radius: clamp(1.75rem, 3vw, 2.5rem);
    padding: clamp(1.75rem, 3vw, 2.35rem);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(1.25rem, 2.4vw, 1.8rem);
    min-height: clamp(14rem, 19vw, 17.5rem);
    transition:
      transform var(--duration-smooth) var(--ease-default),
      border-color var(--duration-smooth) var(--ease-default);
  }

  .process-card:hover {
    transform: translateY(-2px);
    border-color: rgba(10, 10, 10, 0.3);
  }

  .card-num {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border: 1px solid rgba(10, 10, 10, 0.14);
    border-radius: 50%;
    color: #29313d;
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1;
  }

  /* Card Body */
  .card-body {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .card-title {
    font-size: clamp(1.3rem, 1.8vw, 1.55rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 0;
    color: var(--text-light-primary);
  }

  .card-desc {
    font-size: clamp(0.9375rem, 1.2vw, 1rem);
    line-height: 1.45;
    color: #4b5563;
    font-weight: 500;
    max-width: 27ch;
    text-wrap: pretty;
  }
</style>
