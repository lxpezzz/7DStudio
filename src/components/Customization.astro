---
import { Image } from "astro:assets";
import expositorImg from "../assets/products/expositor.webp";
import tarjetasImg from "../assets/products/tarjetas.webp";

const products = [
  {
    id: "expositor",
    num: "01",
    name: "Expositor QR",
    image: expositorImg,
    alt: "Expositor QR personalizado para mostrador y negocios",
    tagline: "Presencia física en mostradores y mesas",
  },
  {
    id: "tarjeta",
    num: "02",
    name: "Tarjeta NFC",
    image: tarjetasImg,
    alt: "Tarjeta NFC corporativa personalizada con QR",
    tagline: "Contacto directo en mano y reuniones",
  },
];

const attributes = [
  {
    id: "diseno",
    label: "Diseño",
    description: "Adaptamos la composición al estilo visual de tu negocio.",
  },
  {
    id: "identidad",
    label: "Identidad",
    description: "Colores, nombre, logo y mensajes coherentes con tu marca.",
  },
  {
    id: "tecnologia",
    label: "Tecnología",
    description: "QR y NFC configurados para que la interacción sea inmediata.",
  },
  {
    id: "destino",
    label: "Destino",
    description:
      "Reseñas de Google, reservas, Instagram, carta digital, contacto o tu web.",
  },
];
---

<section class="customization-section" id="personalizacion" data-customization data-header-theme="dark">
  <div class="section-container">
    <div class="customization-layout">
      <!-- Left Column: Editorial Intro & Product Selector -->
      <div class="customization-intro">

        <h2 class="customization-h2">
          Hecho para tu negocio.<br />
          No para cualquiera.
        </h2>

        <p class="customization-desc">
          Diseñamos expositores QR y tarjetas NFC que se integran con la
          identidad de tu negocio y conectan cada interacción física con el
          destino digital adecuado.
        </p>

        <!-- Product Selector: 01 Expositor QR / 02 Tarjeta NFC -->
        <div
          class="customization-products"
          role="tablist"
          aria-label="Seleccionar producto a personalizar"
        >
          {
            products.map((product, index) => (
              <button
                type="button"
                role="tab"
                class={`product-btn ${index === 0 ? "is-active" : ""}`}
                id={`product-tab-${product.id}`}
                data-product-index={index}
                data-product={product.id}
                data-tagline={product.tagline}
                aria-selected={index === 0 ? "true" : "false"}
                aria-controls={`product-visual-${product.id}`}
              >
                <span class="product-num">{product.num}</span>
                <span class="product-name">{product.name}</span>
                <span class="product-marker" aria-hidden="true">
                  <span class="product-marker-fill" />
                </span>
              </button>
            ))
          }
        </div>
      </div>

      <!-- Right Column: Visual Stage & Attribute Configurator -->
      <div class="customization-showcase">
        <!-- Visual Frame -->
        <div class="customization-visual-card">
          <div class="visual-viewport" id="customizationVisualViewport">
            {
              products.map((product, index) => (
                <div
                  class={`visual-image-pane ${index === 0 ? "is-active" : ""}`}
                  id={`product-visual-${product.id}`}
                  data-image-index={index}
                  data-image={product.id}
                  aria-hidden={index === 0 ? "false" : "true"}
                >
                  <Image
                    src={product.image}
                    alt={product.alt}
                    class="product-image"
                    width={680}
                    height={500}
                    loading="lazy"
                  />
                </div>
              ))
            }
          </div>

          <!-- Active Product Tagline -->
          <div class="visual-tagline-bar">
            <span class="tagline-dot" aria-hidden="true"></span>
            <span class="tagline-text" id="customizationTagline" data-tagline>
              {products[0].tagline}
            </span>
          </div>
        </div>

        <!-- Attribute Selector Bar -->
        <div class="attributes-wrapper">
          <div
            class="attributes-nav"
            role="tablist"
            aria-label="Atributos configurables"
          >
            {
              attributes.map((attribute, index) => (
                <button
                  type="button"
                  role="tab"
                  class={`attr-btn ${index === 0 ? "is-active" : ""}`}
                  id={`attr-tab-${attribute.id}`}
                  data-attribute-index={index}
                  data-attribute={attribute.id}
                  data-description={attribute.description}
                  aria-selected={index === 0 ? "true" : "false"}
                >
                  <span>{attribute.label}</span>
                </button>
              ))
            }
          </div>

          <!-- Dynamic Attribute Description Text -->
          <div class="attribute-desc-stage">
            <p class="attribute-desc-text" id="customizationCopy" data-copy>
              {attributes[0].description}
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Section Setup */
  .customization-section {
    width: 100%;
    position: relative;
    padding-block: var(--section-space-md);
    background-color: var(--bg-page);
  }

  .customization-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    width: 100%;
  }

  @media (min-width: 1024px) {
    .customization-layout {
      grid-template-columns: 0.9fr 1.1fr;
      gap: clamp(3.5rem, 6vw, 6rem);
      align-items: start;
    }
  }

  /* ==========================================================================
     Left Column: Editorial Context & Product Tabs
     ========================================================================== */
  .customization-intro {
    display: flex;
    flex-direction: column;
    width: 100%;
  }


  .customization-h2 {
    font-size: clamp(1.95rem, 3.4vw, 2.85rem);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: var(--tracking-tightest);
    color: var(--text-light-primary);
    margin-bottom: 1.25rem;
    text-wrap: balance;
  }

  .customization-desc {
    font-size: var(--text-body-lg);
    line-height: var(--leading-relaxed);
    color: var(--text-light-secondary);
    max-width: 42ch;
    text-wrap: pretty;
  }

  /* 01 / 02 Product Selector Tabs */
  .customization-products {
    display: flex;
    flex-direction: column;
    gap: 4px;
    width: 100%;
    margin-top: clamp(2rem, 4vw, 3.5rem);
    border-top: 1px solid var(--border-light-subtle);
    padding-top: 0.75rem;
  }

  .product-btn {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.85rem 0.75rem;
    border-radius: 8px;
    background: transparent;
    border: none;
    cursor: pointer;
    text-align: left;
    opacity: 0.45;
    transition:
      opacity var(--duration-quick) var(--ease-default),
      transform var(--duration-quick) var(--ease-default),
      background-color var(--duration-quick) var(--ease-default);
  }

  .product-btn:hover {
    opacity: 0.8;
    transform: translateX(3px);
  }

  .product-btn.is-active {
    opacity: 1;
    background-color: rgba(10, 10, 10, 0.03);
    transform: translateX(4px);
  }

  .product-num {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-light-secondary);
    font-family: monospace;
    letter-spacing: 0.04em;
    flex-shrink: 0;
  }

  .product-btn.is-active .product-num {
    color: var(--text-light-primary);
  }

  .product-name {
    font-size: clamp(1.1rem, 1.4vw, 1.25rem);
    font-weight: 500;
    color: var(--text-light-primary);
    letter-spacing: -0.01em;
  }

  .product-btn.is-active .product-name {
    font-weight: 600;
  }

  .product-marker {
    display: none;
    margin-left: auto;
    width: 28px;
    height: 2px;
    background-color: rgba(10, 10, 10, 0.08);
    border-radius: 999px;
    overflow: hidden;
    position: relative;
    flex-shrink: 0;
  }

  .product-marker-fill {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background-color: var(--text-light-primary);
    border-radius: inherit;
    transform-origin: left center;
    transform: scaleX(0);
  }

  @media (min-width: 1024px) {
    .product-btn.is-active .product-marker {
      display: block;
    }
  }

  /* ==========================================================================
     Right Column: Visual Stage & Attribute Configurator
     ========================================================================== */
  .customization-showcase {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    width: 100%;
    min-width: 0;
  }

  /* Visual Card Frame */
  .customization-visual-card {
    position: relative;
    width: 100%;
    background-color: var(--bg-canvas-light);
    border: 1px solid var(--border-light-subtle);
    border-radius: var(--canvas-radius);
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    box-shadow: 0 20px 48px -16px rgba(0, 0, 0, 0.06);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    overflow: hidden;
  }

  .visual-viewport {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 11;
    border-radius: calc(var(--canvas-radius) - 6px);
    overflow: hidden;
    background-color: #0b0d12;
  }

  .visual-image-pane {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    pointer-events: none;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .visual-image-pane.is-active {
    opacity: 1;
    pointer-events: auto;
    position: absolute;
  }

  .product-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    user-select: none;
  }

  /* Tagline Bar */
  .visual-tagline-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-caption);
    font-weight: 500;
    color: var(--text-light-secondary);
  }

  .tagline-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background-color: var(--text-light-primary);
    flex-shrink: 0;
  }

  .tagline-text {
    color: var(--text-light-secondary);
  }

  /* Attributes Configurator */
  .attributes-wrapper {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    width: 100%;
  }

  .attributes-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    border-bottom: 1px solid var(--border-light-subtle);
    padding-bottom: 0.75rem;
  }

  .attr-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 36px;
    padding-inline: 1rem;
    border-radius: var(--pill-radius);
    background-color: transparent;
    border: 1px solid transparent;
    color: var(--text-light-secondary);
    font-size: var(--text-body-sm);
    font-weight: 500;
    letter-spacing: -0.01em;
    cursor: pointer;
    transition:
      background-color var(--duration-quick) var(--ease-default),
      color var(--duration-quick) var(--ease-default),
      border-color var(--duration-quick) var(--ease-default);
  }

  .attr-btn:hover {
    color: var(--text-light-primary);
    background-color: rgba(10, 10, 10, 0.03);
  }

  .attr-btn.is-active {
    background-color: var(--text-light-primary);
    color: #ffffff;
    font-weight: 600;
  }

  /* Attribute Description Stage */
  .attribute-desc-stage {
    min-height: 48px;
    display: flex;
    align-items: flex-start;
  }

  .attribute-desc-text {
    font-size: clamp(0.9375rem, 1.15vw, 1.0625rem);
    line-height: 1.55;
    color: var(--text-light-secondary);
    max-width: 48ch;
    font-weight: 400;
    text-wrap: pretty;
  }

  @media (prefers-reduced-motion: reduce) {
    .product-btn,
    .attr-btn {
      transition: none !important;
    }
  }
</style>
