---
import { Image } from 'astro:assets';
import prototypesData from '../data/prototypes.json';

import hairxImg from '../assets/prototypes/hairx.webp';
import artisanImg from '../assets/prototypes/artisan.webp';
import luminaImg from '../assets/prototypes/lumina.webp';

const imagesMap: Record<string, ImageMetadata> = {
  'hairx': hairxImg,
  'artisan': artisanImg,
  'lumina': luminaImg,
};
---

<section class="prototypes-section" id="prototipos">
  <div class="section-container">
    <!-- Header -->
    <header class="prototypes-header">
      <div class="header-top">
        <span class="prototypes-eyebrow">Prototipos</span>
        <span class="prototypes-counter">{prototypesData.length.toString().padStart(2, '0')} Demos</span>
      </div>
      <h2 class="prototypes-h2">Diseñamos antes de construir.</h2>
      <p class="prototypes-desc">
        Explora diferentes conceptos web creados por 7DStudio para distintos tipos de negocio.
      </p>
    </header>

    <!-- Visual Portfolio Grid -->
    <div class="demos-grid">
      {prototypesData.map((item) => (
        <a 
          href={item.url} 
          class="demo-card"
          aria-label={`Explorar demo de ${item.name}`}
        >
          <div class="demo-visual-wrap">
            <Image 
              src={imagesMap[item.image]} 
              alt={`Captura del prototipo ${item.name}`}
              class="demo-img"
              loading="lazy"
              width={1200}
              height={750}
            />

            <!-- Hover Floating Overlay -->
            <div class="demo-overlay" aria-hidden="true">
              <div class="demo-overlay-content">
                <span class="demo-title">{item.name}</span>
                <span class="demo-action">
                  <span>Explorar demo</span>
                  <svg class="demo-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none">
                    <path d="M3.333 8h9.334M8.667 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  /* Section Layout */
  .prototypes-section {
    width: 100%;
    position: relative;
    padding-block: clamp(3rem, 6vw, 5.5rem);
  }

  /* Header */
  .prototypes-header {
    display: flex;
    flex-direction: column;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  .header-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.15rem;
  }

  .prototypes-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: var(--text-caption);
    font-weight: 600;
    color: var(--text-light-secondary);
    letter-spacing: -0.01em;
  }

  .prototypes-eyebrow::before {
    content: "";
    width: 5.5px;
    height: 5.5px;
    border-radius: 50%;
    background-color: var(--text-light-primary);
    flex-shrink: 0;
  }

  .prototypes-counter {
    font-size: var(--text-caption);
    font-weight: 500;
    color: var(--text-light-secondary);
    background: rgba(10, 10, 10, 0.04);
    border: 1px solid var(--border-light-subtle);
    padding: 0.25rem 0.75rem;
    border-radius: var(--pill-radius);
    font-variant-numeric: tabular-nums;
  }

  .prototypes-h2 {
    font-size: clamp(1.95rem, 3.4vw, 2.85rem);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: var(--tracking-tightest);
    color: var(--text-light-primary);
    margin-bottom: 0.85rem;
    text-wrap: balance;
  }

  .prototypes-desc {
    font-size: var(--text-body-lg);
    line-height: var(--leading-relaxed);
    color: var(--text-light-secondary);
    max-width: 48ch;
    text-wrap: pretty;
  }

  /* Portfolio Grid */
  .demos-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.25rem, 2.5vw, 1.75rem);
    width: 100%;
  }

  @media (min-width: 768px) {
    .demos-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Clickable Demo Item */
  .demo-card {
    display: block;
    width: 100%;
    position: relative;
    border-radius: var(--canvas-radius);
    overflow: hidden;
    background-color: var(--bg-canvas-light);
    border: 1px solid var(--border-light-subtle);
    box-shadow: 0 16px 36px -12px rgba(0, 0, 0, 0.06);
    outline: none;
    transition: 
      transform var(--duration-smooth) var(--ease-default),
      box-shadow var(--duration-smooth) var(--ease-default),
      border-color var(--duration-smooth) var(--ease-default);
  }

  .demo-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 24px 48px -12px rgba(0, 0, 0, 0.12);
    border-color: rgba(10, 10, 10, 0.15);
  }

  .demo-card:focus-visible {
    outline: 2px solid var(--text-light-primary);
    outline-offset: 3px;
  }

  /* Visual Stage */
  .demo-visual-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background-color: #0c0e14;
  }

  .demo-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    user-select: none;
    transition: transform 0.5s var(--ease-default);
  }

  .demo-card:hover .demo-img {
    transform: scale(1.025);
  }

  /* Hover Overlay */
  .demo-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.75) 0%,
      rgba(0, 0, 0, 0.25) 45%,
      transparent 75%
    );
    display: flex;
    align-items: flex-end;
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    opacity: 0;
    transition: opacity var(--duration-smooth) var(--ease-default);
  }

  .demo-card:hover .demo-overlay,
  .demo-card:focus-visible .demo-overlay {
    opacity: 1;
  }

  .demo-overlay-content {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    transform: translateY(8px);
    transition: transform var(--duration-smooth) var(--ease-default);
  }

  .demo-card:hover .demo-overlay-content,
  .demo-card:focus-visible .demo-overlay-content {
    transform: translateY(0);
  }

  .demo-title {
    font-size: var(--text-body);
    font-weight: 600;
    color: #ffffff;
    letter-spacing: -0.01em;
  }

  .demo-action {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: var(--text-caption);
    font-weight: 600;
    color: #ffffff;
    letter-spacing: -0.01em;
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    padding: 0.4rem 0.85rem;
    border-radius: var(--pill-radius);
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .demo-arrow {
    transition: transform var(--duration-quick) var(--ease-default);
  }

  .demo-card:hover .demo-arrow {
    transform: translateX(3px);
  }

  /* Mobile Touch Adjustments */
  @media (max-width: 640px) {
    .demo-overlay {
      opacity: 1;
      background: linear-gradient(
        to top,
        rgba(0, 0, 0, 0.7) 0%,
        transparent 55%
      );
      padding: 1rem;
    }

    .demo-overlay-content {
      transform: translateY(0);
    }

    .demo-title {
      font-size: var(--text-body-sm);
    }

    .demo-action {
      padding: 0.3rem 0.65rem;
      font-size: 0.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .demo-card,
    .demo-img,
    .demo-overlay,
    .demo-overlay-content,
    .demo-arrow {
      transition: none !important;
    }
  }
</style>
