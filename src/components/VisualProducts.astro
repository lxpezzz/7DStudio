---
import { Image } from "astro:assets";
import visualProductsData from "../data/solutions.json";

import websImg from "../assets/solutions/webs.webp";
import qrNfcImg from "../assets/solutions/qr-nfc.webp";
import reviewsImg from "../assets/solutions/reviews.webp";
import localSeoImg from "../assets/solutions/local-seo.webp";
import cardsImg from "../assets/solutions/cards.webp";
import upcomingImg from "../assets/solutions/upcoming.webp";

const imagesMap: Record<string, ImageMetadata> = {
  webs: websImg,
  "qr-nfc": qrNfcImg,
  reviews: reviewsImg,
  "local-seo": localSeoImg,
  cards: cardsImg,
  upcoming: upcomingImg,
};
---

<section class="visual-products-section" id="soluciones">
  <div class="section-container">
    <div class="visual-products-canvas">
      <div class="visual-products-grid" id="visualProductsShowcase">
        <!-- LEFT COLUMN: Editorial Header, Interactive Tabs & Detail Copy -->
        <div class="visual-products-left">
          <div class="visual-products-header">
            <h2 class="visual-products-h2">
              Una presencia digital.<br />Todo conectado.
            </h2>

            <!-- Interactive Selector Tabs -->
            <div
              class="visual-products-tabs"
              role="tablist"
              aria-label="Soluciones para negocios"
            >
              {
                visualProductsData.map((item, index) => (
                  <button
                    type="button"
                    role="tab"
                    class={`tab-btn ${index === 0 ? "is-active" : ""} ${item.isUpcoming ? "is-upcoming" : ""}`}
                    data-solution-index={index}
                    aria-selected={index === 0 ? "true" : "false"}
                    id={`tab-${item.id}`}
                    aria-controls={`panel-${item.id}`}
                  >
                    <span>{item.tab}</span>
                  </button>
                ))
              }
            </div>
          </div>

          <!-- Dynamic Explanation Copy -->
          <div class="visual-products-detail">
            {
              visualProductsData.map((item, index) => (
                <div
                  class={`detail-pane ${index === 0 ? "is-active" : ""}`}
                  data-detail-index={index}
                  id={`panel-${item.id}`}
                  role="tabpanel"
                  aria-labelledby={`tab-${item.id}`}
                  aria-hidden={index === 0 ? "false" : "true"}
                >
                  <h3 class="detail-h3">{item.title}</h3>
                  <p class="detail-p">{item.description}</p>
                </div>
              ))
            }
          </div>
        </div>

        <!-- RIGHT COLUMN: Vertical Visual Showcase Area -->
        <div class="visual-products-right">
          <div class="visual-viewport">
            {
              visualProductsData.map((item, index) => (
                <div
                  class={`visual-item ${index === 0 ? "is-active" : ""}`}
                  data-visual-index={index}
                  aria-hidden={index === 0 ? "false" : "true"}
                >
                  <Image
                    src={imagesMap[item.image]}
                    alt={item.title}
                    class="solution-image"
                    loading="lazy"
                    width={900}
                    height={1100}
                  />
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Section Layout */
  .visual-products-section {
    width: 100%;
    position: relative;
  }

  /* Align the showcase with the hero's wider content frame. */
  .visual-products-section :global(.section-container) {
    max-width: var(--container-hero);
    padding-inline: 0;
  }

  .visual-products-canvas {
    width: 100%;
    max-width: var(--container-hero);
    margin-inline: auto;
    display: flex;
    flex-direction: column;

    background: var(--bg-canvas-light);
    color: var(--text-light-primary);
    border: 1px solid var(--border-light-subtle);
    border-radius: var(--canvas-radius);

    padding: clamp(1.75rem, 3.5vw, 3rem);
    overflow: hidden;
  }

  .visual-products-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 3.5vw, 3.5rem);
    width: 100%;
  }

  @media (min-width: 1024px) {
    .visual-products-grid {
      grid-template-columns: 1.1fr 0.9fr;
      min-height: 540px;
      max-height: 600px;
      align-items: stretch;
    }
  }

  /* Left Column: Heading, Tabs & Detail */
  .visual-products-left {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2.5rem;
  }

  .visual-products-header {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .visual-products-h2 {
    font-size: clamp(1.85rem, 3.2vw, 2.75rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: #0e1014;
    text-wrap: balance;
  }

  /* Selector Tabs */
  .visual-products-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  @media (max-width: 768px) {
    .visual-products-tabs {
      flex-wrap: nowrap;
      overflow-x: auto;
      padding-bottom: 6px;
      margin-inline: -4px;
      padding-inline: 4px;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }

    .visual-products-tabs::-webkit-scrollbar {
      display: none;
    }
  }

  .tab-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 40px;
    padding-inline: 1.15rem;
    border-radius: var(--pill-radius);
    background-color: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.08);
    color: #40444f;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    white-space: nowrap;
    cursor: pointer;
    flex-shrink: 0;
    transition:
      background-color var(--duration-quick) var(--ease-default),
      border-color var(--duration-quick) var(--ease-default),
      color var(--duration-quick) var(--ease-default),
      transform var(--duration-quick) var(--ease-default);
  }

  .tab-btn:hover {
    background-color: #eaeae6;
    color: #0e1014;
    transform: translateY(-1px);
  }

  .tab-btn.is-active {
    background-color: #0e1014;
    border-color: #0e1014;
    color: #ffffff;
    font-weight: 600;
  }

  .tab-btn.is-upcoming {
    background-color: transparent;
    border: 1px dashed rgba(0, 0, 0, 0.2);
    color: #6e727e;
  }

  .tab-btn.is-upcoming.is-active {
    background-color: #0e1014;
    border: 1px solid #0e1014;
    color: #ffffff;
  }

  /* Detail Pane */
  .visual-products-detail {
    position: relative;
    min-height: 120px;
    display: flex;
    align-items: flex-end;
  }

  .detail-pane {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    opacity: 0;
    transform: translateY(6px);
    pointer-events: none;
    transition:
      opacity 0.3s var(--ease-default),
      transform 0.3s var(--ease-default);
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .detail-pane.is-active {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
    position: relative;
  }

  .detail-h3 {
    font-size: clamp(1.25rem, 1.8vw, 1.55rem);
    font-weight: 600;
    line-height: 1.22;
    letter-spacing: -0.02em;
    color: #0e1014;
    text-wrap: balance;
  }

  .detail-p {
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--text-light-secondary);
    max-width: 480px;
    font-weight: 400;
    text-wrap: pretty;
  }

  /* Right Column: Visual Stage */
  .visual-products-right {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 360px;
  }

  @media (max-width: 1023px) {
    .visual-products-right {
      min-height: 380px;
      order: 2;
    }

    .visual-products-detail {
      order: 3;
    }
  }

  .visual-viewport {
    position: relative;
    width: 100%;
    height: 100%;
    background-color: #0b0b0b;
    background-image: radial-gradient(
      120% 90% at 70% 15%,
      #252525 0%,
      #131313 55%,
      #0a0a0a 100%
    );
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: calc(var(--canvas-radius) - 6px);
    overflow: hidden;
    box-shadow: 0 16px 36px -12px rgba(0, 0, 0, 0.15);
  }

  .visual-item {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: scale(0.985);
    pointer-events: none;
    transition:
      opacity 0.32s var(--ease-default),
      transform 0.32s var(--ease-default);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .visual-item.is-active {
    opacity: 1;
    transform: scale(1);
    pointer-events: auto;
    z-index: 2;
  }

  .solution-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    user-select: none;
  }
</style>
