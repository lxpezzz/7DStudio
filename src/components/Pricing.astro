---
import pricingData from "../data/pricing.json";
import PricingComparison from "./pricing/PricingComparison.astro";
import ProductCard from "./pricing/ProductCard.astro";
import PricingCTA from "./pricing/PricingCTA.astro";

const { header, webServices, physicalProducts, cta } = pricingData;
---

<section class="pricing-solutions-section" id="precios" data-pricing>
  <div class="section-container">
    <!-- Header de sección -->
    <header class="section-header" data-reveal>
      <div class="section-eyebrow">
        <span class="eyebrow-dot" aria-hidden="true"></span>
        <span>{header.eyebrow}</span>
      </div>

      <div class="header-content-grid">
        <h2 class="section-title">
          {header.title}
        </h2>

        <p class="section-subtitle">
          {header.description}
        </p>
      </div>
    </header>

    <!-- Bloque 01 — Desarrollo Web: Comparison Grid -->
    <PricingComparison
      sectionCode={webServices.sectionCode}
      sectionTitle={webServices.sectionTitle}
      plans={webServices.plans}
      comparisonFeatures={webServices.comparisonFeatures}
    />

    <!-- Bloque 02 — Productos Físicos -->
    <div class="block-physical-products" data-reveal>
      <div class="block-label">
        <span class="block-code">{physicalProducts.sectionCode}</span>
        <span class="block-name">{physicalProducts.sectionTitle}</span>
      </div>

      {
        physicalProducts.subtitle && (
          <p class="physical-block-subtitle">{physicalProducts.subtitle}</p>
        )
      }

      <div class="physical-grid">
        {
          physicalProducts.products.map((product) => (
            <ProductCard product={product} />
          ))
        }
      </div>
    </div>

    <!-- CTA Final -->
    <PricingCTA
      title={cta.title}
      description={cta.description}
      buttonLabel={cta.buttonLabel}
      buttonHref={cta.buttonHref}
    />
  </div>
</section>

<style>
  .pricing-solutions-section {
    width: 100%;
    position: relative;
    padding-block: clamp(4.5rem, 8vw, 8.5rem);
    background-color: var(--bg-page);
  }

  /* Header de Sección */
  .section-header {
    display: flex;
    flex-direction: column;
    width: 100%;
    margin-bottom: clamp(3.5rem, 6vw, 5.5rem);
  }

  .section-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-caption);
    font-weight: 600;
    color: var(--text-light-secondary);
    letter-spacing: -0.01em;
    margin-bottom: 1.25rem;
  }

  .eyebrow-dot {
    width: 5.5px;
    height: 5.5px;
    border-radius: 50%;
    background-color: var(--text-light-primary);
    flex-shrink: 0;
  }

  .header-content-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.25rem, 2.5vw, 2.5rem);
    align-items: end;
  }

  @media (min-width: 1024px) {
    .header-content-grid {
      grid-template-columns: 1.15fr 0.85fr;
      gap: clamp(3rem, 5vw, 5.5rem);
    }
  }

  .section-title {
    font-size: clamp(2.15rem, 4.2vw, 3.75rem);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: var(--tracking-tightest);
    color: var(--text-light-primary);
    text-wrap: balance;
  }

  .section-subtitle {
    font-size: var(--text-body-lg);
    line-height: var(--leading-relaxed);
    color: var(--text-light-secondary);
    max-width: 44ch;
    text-wrap: pretty;
    padding-bottom: 0.35rem;
  }

  /* Bloque 02 — Productos Físicos Layout */
  .block-physical-products {
    display: flex;
    flex-direction: column;
    width: 100%;
    margin-bottom: clamp(4.5rem, 7.5vw, 7.5rem);
  }

  .block-label {
    display: inline-flex;
    align-items: baseline;
    gap: 0.75rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border-light-subtle);
    width: 100%;
    margin-bottom: clamp(1.75rem, 3vw, 2.5rem);
  }

  .block-code {
    font-size: 0.875rem;
    font-family: monospace;
    font-weight: 600;
    color: var(--text-light-secondary);
    opacity: 0.6;
  }

  .block-name {
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-light-primary);
  }

  .physical-block-subtitle {
    font-size: var(--text-body);
    line-height: var(--leading-relaxed);
    color: var(--text-light-secondary);
    margin-top: -0.75rem;
    margin-bottom: clamp(1.75rem, 3vw, 2.5rem);
    max-width: 52ch;
    text-wrap: pretty;
  }

  .physical-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.5rem, 2.5vw, 2.25rem);
    width: 100%;
  }

  @media (min-width: 768px) {
    .physical-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
