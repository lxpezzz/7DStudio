---
import siteData from "../data/site.json";
---

<header class="studio-header">
  <div class="header-inner">
    <!-- Logo -->
    <a href="/" class="glass-pill brand" aria-label="7DStudio - Inicio">
      <strong>7D</strong><span>Studio</span>
    </a>

    <!-- Desktop navigation -->
    <nav class="glass-pill desktop-nav" aria-label="Navegación principal">
      {siteData.nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <!-- Desktop CTA -->
    <a href={siteData.cta.href} class="header-cta">
      <span>{siteData.cta.label}</span>

      <span class="cta-icon" aria-hidden="true">
        <svg viewBox="0 0 12 12">
          <path
            d="M2.5 9.5 9.5 2.5M9.5 2.5H4M9.5 2.5V8"
            fill="none"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </span>
    </a>

    <!-- Mobile menu -->
    <button
      class="glass-pill menu-toggle"
      id="menuToggle"
      type="button"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobileMenu"
    >
      <span></span>
      <span></span>
    </button>
  </div>

  <!-- Mobile navigation -->
  <div class="mobile-menu" id="mobileMenu" hidden>
    <nav aria-label="Navegación móvil">
      {siteData.nav.map((item) => <a href={item.href}>{item.label}</a>)}

      <a href={siteData.cta.href} class="mobile-cta">
        {siteData.cta.label}
        <span aria-hidden="true">↗</span>
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("menuToggle");
  const menu = document.getElementById("mobileMenu");

  function closeMenu() {
    if (!toggle || !menu) return;

    toggle.setAttribute("aria-expanded", "false");
    toggle.classList.remove("is-open");
    menu.hidden = true;
    document.body.style.overflow = "";
  }

  function openMenu() {
    if (!toggle || !menu) return;

    toggle.setAttribute("aria-expanded", "true");
    toggle.classList.add("is-open");
    menu.hidden = false;
    document.body.style.overflow = "hidden";
  }

  toggle?.addEventListener("click", () => {
    const isOpen = toggle.getAttribute("aria-expanded") === "true";

    isOpen ? closeMenu() : openMenu();
  });

  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", closeMenu);
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeMenu();
  });
</script>

<style>
  /* Header */

  .studio-header {
    position: fixed;
    top: 18px;
    inset-inline: 0;
    z-index: 100;
  }

  .header-inner {
    width: min(calc(100% - 32px), 1180px);
    margin-inline: auto;

    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 24px;
  }

  /* Shared translucent surface */

  .glass-pill {
    background: rgba(28, 30, 35, 0.68);
    border: 1px solid rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-radius: var(--pill-radius);
  }

  /* Brand */

  .brand {
    display: inline-flex;
    align-items: center;

    height: 42px;
    padding-inline: 18px;

    color: var(--text-primary);
    font-size: 0.9375rem;
    letter-spacing: -0.025em;

    justify-self: start;
  }

  .brand strong {
    font-weight: 700;
  }

  .brand span {
    color: var(--text-secondary);
    font-weight: 500;
  }

  /* Navigation */

  .desktop-nav {
    display: flex;
    align-items: center;
    justify-self: center;

    padding: 4px 8px;
  }

  .desktop-nav a {
    padding: 8px 15px;

    border-radius: var(--pill-radius);

    color: var(--text-secondary);
    font-size: var(--text-caption);
    font-weight: 500;

    transition:
      color var(--duration-quick) var(--ease-default),
      background-color var(--duration-quick) var(--ease-default);
  }

  .desktop-nav a:hover {
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.08);
  }

  /* CTA */

  .header-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;

    height: 42px;
    padding: 5px 6px 5px 18px;

    justify-self: end;

    background: #fff;
    color: #08080a;
    border-radius: var(--pill-radius);

    font-size: var(--text-caption);
    font-weight: 600;

    transition:
      transform var(--duration-quick) var(--ease-default),
      background-color var(--duration-quick) var(--ease-default);
  }

  .header-cta:hover {
    background: #f1f1f1;
    transform: translateY(-1px);
  }

  .cta-icon {
    width: 30px;
    aspect-ratio: 1;

    display: grid;
    place-items: center;

    border-radius: 50%;
    background: rgba(0, 0, 0, 0.08);
  }

  .cta-icon svg {
    width: 12px;
    height: 12px;
  }

  /* Mobile */

  .menu-toggle,
  .mobile-menu {
    display: none;
  }

  @media (max-width: 767px) {
    .studio-header {
      top: 12px;
    }

    .header-inner {
      width: calc(100% - 24px);
      grid-template-columns: auto 1fr auto;
      gap: 12px;
    }

    .desktop-nav,
    .header-cta {
      display: none;
    }

    .menu-toggle {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 5px;

      width: 42px;
      height: 42px;
      padding: 0;

      grid-column: 3;
      justify-self: end;

      color: #fff;
    }

    .menu-toggle span {
      width: 16px;
      height: 1.5px;

      background: currentColor;
      border-radius: 2px;

      transition: transform 200ms var(--ease-default);
    }

    .menu-toggle.is-open span:first-child {
      transform: translateY(3.25px) rotate(45deg);
    }

    .menu-toggle.is-open span:last-child {
      transform: translateY(-3.25px) rotate(-45deg);
    }

    .mobile-menu {
      position: fixed;
      top: 66px;
      left: 12px;
      right: 12px;

      padding: 18px;

      background: rgba(18, 20, 24, 0.92);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: var(--card-radius);

      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
    }

    .mobile-menu:not([hidden]) {
      display: block;
    }

    .mobile-menu nav {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .mobile-menu a {
      padding: 13px 14px;

      color: var(--text-secondary);
      font-size: 1rem;
      font-weight: 500;

      border-radius: 12px;
    }

    .mobile-menu a:hover,
    .mobile-menu a:focus-visible {
      color: #fff;
      background: rgba(255, 255, 255, 0.07);
    }

    .mobile-menu .mobile-cta {
      margin-top: 8px;

      display: flex;
      align-items: center;
      justify-content: space-between;

      background: #fff;
      color: #08080a;
      font-weight: 600;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .desktop-nav a,
    .header-cta,
    .menu-toggle span {
      transition: none;
    }
  }
</style>
