---
import siteData from "../data/site.json";
---

<header class="studio-header" data-theme="light">
  <div class="header-inner">
    <!-- Logo -->
    <a href="/" class="glass-pill brand" aria-label="7DStudio - Inicio">
      <img
        src="/images/7dstudio-logo.svg"
        alt="7DStudio"
        class="brand-logo"
        width="120"
        height="32"
      />
    </a>

    <!-- Desktop navigation -->
    <nav class="glass-pill desktop-nav" aria-label="Navegación principal">
      {
        siteData.nav.map((item) => (
          <a href={item.href}>
            {item.label === "Demos" && (
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="lucide lucide-globe-check-icon lucide-globe-check"
                aria-hidden="true"
              >
                <path d="m15 6 2 2 4-4" />
                <path d="M2 12h20A10 10 0 1 1 12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 4-10" />
              </svg>
            )}
            {item.label}
            {item.label === "Precios" && (
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="lucide lucide-dollar-sign-icon lucide-dollar-sign"
                aria-hidden="true"
              >
                <line x1="12" x2="12" y1="2" y2="22" />
                <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
              </svg>
            )}
          </a>
        ))
      }
    </nav>

    <!-- Desktop CTA -->
    <a href={siteData.cta.href} class="header-cta">
      <span>{siteData.cta.label}</span>

      <span class="cta-icon" aria-hidden="true">
        <svg viewBox="0 0 12 12">
          <path
            d="M2.5 9.5 9.5 2.5M9.5 2.5H4M9.5 2.5V8"
            fill="none"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </span>
    </a>

    <!-- Mobile menu button -->
    <button
      class="glass-pill menu-toggle"
      id="menuToggle"
      type="button"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobileMenu"
    >
      <span></span>
      <span></span>
    </button>
  </div>

  <!-- Mobile navigation -->
  <div class="mobile-menu" id="mobileMenu" hidden>
    <nav aria-label="Navegación móvil">
      {
        siteData.nav.map((item) => (
          <a href={item.href}>
            {item.label === "Demos" && (
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="lucide lucide-globe-check-icon lucide-globe-check"
                aria-hidden="true"
              >
                <path d="m15 6 2 2 4-4" />
                <path d="M2 12h20A10 10 0 1 1 12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 4-10" />
              </svg>
            )}
            {item.label}
            {item.label === "Precios" && (
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="lucide lucide-dollar-sign-icon lucide-dollar-sign"
                aria-hidden="true"
              >
                <line x1="12" x2="12" y1="2" y2="22" />
                <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
              </svg>
            )}
          </a>
        ))
      }

      <a href={siteData.cta.href} class="mobile-cta">
        {siteData.cta.label}
        <span aria-hidden="true">↗</span>
      </a>
    </nav>
  </div>
</header>

<style>
  /* Header Root */
  .studio-header {
    position: fixed;
    top: 1.5rem;
    inset-inline: 0;
    z-index: 100;
  }

  .header-inner {
    width: min(calc(100% - 32px), 1180px);
    margin-inline: auto;

    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 24px;
  }

  /* Shared Glassmorphism Pill */
  .glass-pill {
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-radius: var(--pill-radius);
    transition:
      background-color var(--duration-smooth) var(--ease-default),
      border-color var(--duration-smooth) var(--ease-default),
      box-shadow var(--duration-smooth) var(--ease-default);
  }

  /* Brand */
  .brand {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 42px;
    padding: 0 16px;
    flex-shrink: 0;
  }

  .brand-logo {
    display: block;
    width: auto;
    height: 20px;
    max-width: 120px;
    object-fit: contain;
    transition: filter var(--duration-smooth) var(--ease-default);
  }

  /* Desktop Navigation */
  .desktop-nav {
    display: flex;
    align-items: center;
    justify-self: center;
    padding: 4px 8px;
  }

  .desktop-nav a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 15px;
    border-radius: var(--pill-radius);
    font-size: var(--text-caption);
    font-weight: 500;
    transition:
      color var(--duration-quick) var(--ease-default),
      background-color var(--duration-quick) var(--ease-default);
  }

  .desktop-nav .lucide-dollar-sign {
    flex: 0 0 auto;
  }

  /* CTA Button */
  .header-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 42px;
    padding: 5px 6px 5px 18px;
    justify-self: end;
    border-radius: var(--pill-radius);
    font-size: var(--text-caption);
    font-weight: 600;
    transition:
      transform var(--duration-quick) var(--ease-default),
      background-color var(--duration-smooth) var(--ease-default),
      color var(--duration-smooth) var(--ease-default),
      box-shadow var(--duration-smooth) var(--ease-default);
  }

  .header-cta:hover {
    transform: translateY(-1px);
  }

  .cta-icon {
    width: 30px;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    border-radius: 50%;
    transition:
      background-color var(--duration-smooth) var(--ease-default),
      color var(--duration-smooth) var(--ease-default);
  }

  .cta-icon svg {
    width: 12px;
    height: 12px;
  }

  /* Mobile Toggle & Menu */
  .menu-toggle,
  .mobile-menu {
    display: none;
  }

  .menu-toggle span {
    width: 16px;
    height: 1.5px;
    background: currentColor;
    border-radius: 2px;
    transition:
      transform 200ms var(--ease-default),
      background-color var(--duration-smooth) var(--ease-default);
  }

  /* ==========================================================================
     Theme: Light (Header appearance when over dark backgrounds)
     ========================================================================== */
  .studio-header[data-theme="light"] .glass-pill {
    background: rgba(28, 30, 35, 0.68);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .studio-header[data-theme="light"] .brand-logo {
    filter: brightness(0) invert(1);
  }

  .studio-header[data-theme="light"] .desktop-nav a {
    color: var(--text-secondary);
  }

  .studio-header[data-theme="light"] .desktop-nav a:hover {
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.08);
  }

  .studio-header[data-theme="light"] .header-cta {
    background: #ffffff;
    color: #08080a;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.18);
  }

  .studio-header[data-theme="light"] .header-cta:hover {
    background: #f1f1f1;
  }

  .studio-header[data-theme="light"] .cta-icon {
    background: rgba(0, 0, 0, 0.08);
    color: #08080a;
  }

  .studio-header[data-theme="light"] .menu-toggle {
    color: #ffffff;
  }

  .studio-header[data-theme="light"] .mobile-menu {
    background: rgba(18, 20, 24, 0.92);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .studio-header[data-theme="light"] .mobile-menu a {
    color: var(--text-secondary);
  }

  .studio-header[data-theme="light"] .mobile-menu a:hover,
  .studio-header[data-theme="light"] .mobile-menu a:focus-visible {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.07);
  }

  .studio-header[data-theme="light"] .mobile-cta {
    background: #ffffff;
    color: #08080a;
  }

  /* ==========================================================================
     Theme: Dark (Header appearance when over light backgrounds)
     ========================================================================== */
  .studio-header[data-theme="dark"] .glass-pill {
    background: rgba(255, 255, 255, 0.72);
    border: 1px solid rgba(10, 10, 10, 0.08);
    box-shadow: 0 4px 20px -4px rgba(0, 0, 0, 0.05);
  }

  .studio-header[data-theme="dark"] .brand-logo {
    filter: brightness(0);
  }

  .studio-header[data-theme="dark"] .desktop-nav a {
    color: rgba(10, 10, 10, 0.65);
  }

  .studio-header[data-theme="dark"] .desktop-nav a:hover {
    color: #0a0a0a;
    background: rgba(10, 10, 10, 0.06);
  }

  .studio-header[data-theme="dark"] .header-cta {
    background: #0a0a0a;
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
  }

  .studio-header[data-theme="dark"] .header-cta:hover {
    background: #242730;
  }

  .studio-header[data-theme="dark"] .cta-icon {
    background: rgba(255, 255, 255, 0.14);
    color: #ffffff;
  }

  .studio-header[data-theme="dark"] .menu-toggle {
    color: #0a0a0a;
  }

  .studio-header[data-theme="dark"] .mobile-menu {
    background: rgba(255, 255, 255, 0.94);
    border: 1px solid rgba(10, 10, 10, 0.08);
    box-shadow: 0 20px 40px -12px rgba(0, 0, 0, 0.1);
  }

  .studio-header[data-theme="dark"] .mobile-menu a {
    color: rgba(10, 10, 10, 0.7);
  }

  .studio-header[data-theme="dark"] .mobile-menu a:hover,
  .studio-header[data-theme="dark"] .mobile-menu a:focus-visible {
    color: #0a0a0a;
    background: rgba(10, 10, 10, 0.05);
  }

  .studio-header[data-theme="dark"] .mobile-cta {
    background: #0a0a0a;
    color: #ffffff;
  }

  /* ==========================================================================
     Responsive & Mobile Breakpoints
     ========================================================================== */
  @media (max-width: 767px) {
    .studio-header {
      top: 12px;
    }

    .header-inner {
      width: calc(100% - 24px);
      grid-template-columns: auto 1fr auto;
      gap: 12px;
    }

    .desktop-nav,
    .header-cta {
      display: none;
    }

    .menu-toggle {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 5px;

      width: 42px;
      height: 42px;
      padding: 0;

      grid-column: 3;
      justify-self: end;
    }

    .menu-toggle.is-open span:first-child {
      transform: translateY(3.25px) rotate(45deg);
    }

    .menu-toggle.is-open span:last-child {
      transform: translateY(-3.25px) rotate(-45deg);
    }

    .mobile-menu {
      position: fixed;
      top: 66px;
      left: 12px;
      right: 12px;

      padding: 18px;
      border-radius: var(--canvas-radius, 20px);

      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      transition:
        background-color var(--duration-smooth) var(--ease-default),
        border-color var(--duration-smooth) var(--ease-default),
        box-shadow var(--duration-smooth) var(--ease-default);
    }

    .mobile-menu:not([hidden]) {
      display: block;
    }

    .mobile-menu nav {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .mobile-menu a {
      display: flex;
      align-items: center;
      gap: 8px;

      padding: 13px 14px;
      font-size: 1rem;
      font-weight: 500;
      border-radius: 12px;
      transition:
        color var(--duration-quick) var(--ease-default),
        background-color var(--duration-quick) var(--ease-default);
    }

    .mobile-menu .mobile-cta {
      margin-top: 8px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-weight: 600;
      transition:
        background-color var(--duration-smooth) var(--ease-default),
        color var(--duration-smooth) var(--ease-default);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .glass-pill,
    .brand-logo,
    .desktop-nav a,
    .header-cta,
    .cta-icon,
    .menu-toggle,
    .menu-toggle span,
    .mobile-menu,
    .mobile-menu a,
    .mobile-cta {
      transition: none !important;
    }
  }
</style>
